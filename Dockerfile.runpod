FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        python3 \
        python3-pip \
        tmux \
        openssh-server \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH=/root/.local/bin:${PATH}

WORKDIR /opt/neuralsignal
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-install-project && uv cache clean

COPY neuralsignal ./neuralsignal
COPY scripts/runpod_entrypoint.sh /usr/local/bin/neuralsignal-runpod-entrypoint
RUN chmod +x /usr/local/bin/neuralsignal-runpod-entrypoint \
    && uv sync --frozen --no-editable

EXPOSE 22

ENTRYPOINT ["/usr/local/bin/neuralsignal-runpod-entrypoint"]
